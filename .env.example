# Copy to .env and fill in real values. .env is git-ignored.

# --- Postgres (TimescaleDB extension enabled on this database) ---
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/deepx

# --- Redis (short-TTL cache only, never source of truth) ---
REDIS_URL=redis://localhost:6379

# --- 9Router (self-hosted OpenAI-compatible LLM router) ---
NINEROUTER_BASE_URL=replace-me
NINEROUTER_API_KEY=replace-me
# Combo names configured in the 9Router dashboard. Defaults match the spec;
# override here if you named your combos differently.
NINEROUTER_ORCHESTRATOR_COMBO=orchestrator
NINEROUTER_SUBAGENT_COMBO=subagent

# --- CoinMarketCap ---
COINMARKETCAP_API_KEY=replace-me
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com

# --- Etherscan API v2 (single key works across chainid=1 ETH, chainid=56 BSC) ---
ETHERSCAN_API_KEY=replace-me
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# --- On-chain flagging threshold ---
ONCHAIN_FLAG_USD_THRESHOLD=100000

# --- Pipeline scheduling ---
# Cron expression for the full pipeline run (node-cron syntax). Default: every 2 hours.
PIPELINE_CRON=0 */2 * * *
# Set to "true" to run the pipeline once immediately on worker boot (useful for local dev/testing)
PIPELINE_RUN_ON_BOOT=false
